# Environment Variables for Sekolah Ceria Website
# Copy this file to .env and fill in your values

# Development Server Configuration
# Default: 3000
PORT=3000

# API Configuration
# Base URL for API calls (optional, defaults to current origin)
# VITE_API_BASE_URL=http://localhost:3000

# Cloudflare Workers Configuration
# These are automatically set by wrangler in production
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token

# Security Configuration
# Comma-separated list of allowed CORS origins (default: empty = no CORS)
# Example: https://example.com,https://www.example.com
# ALLOWED_ORIGINS=

# JWT Secret for authentication (change in production!)
# JWT_SECRET=your-secure-secret-here

# Error Reporting
# Comma-separated list of allowed CORS origins (default: empty = no CORS)
# Example: https://example.com,https://www.example.com
# ALLOWED_ORIGINS=

# Error Reporting
# Enable/disable client error reporting (default: true)
# ENABLE_ERROR_REPORTING=true

# Feature Flags
# Enable/disable specific features (default: false)
# ENABLE_DEMO_MODE=false
